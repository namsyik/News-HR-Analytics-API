{
  "info": {
    "name": "Session 11 — Mini Project 2 API",
    "description": "Postman Collection untuk Mini Project 2.\n\nMemiliki test cases lengkap untuk:\n- TASK 1: Article Search dengan Pagination\n- TASK 2: Article Stats per Source\n- TASK 3: Department Detail Endpoint (Attrition)\n- TASK 4: Attrition Risk Profile",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "my-super-secret-key",
      "type": "string"
    },
    {
      "key": "client_id",
      "value": "demo_client",
      "type": "string"
    },
    {
      "key": "client_secret",
      "value": "demo_secret_value",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Public",
      "item": [
        {
          "name": "Root",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/",
              "host": ["{{base_url}}"],
              "path": [""]
            },
            "description": "Public — no auth needed. Returns API info and available paths."
          }
        },
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Public — returns status and server timestamp."
          }
        }
      ],
      "description": "No authentication required."
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "Get JWT Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var json = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', json.access_token);",
                  "    pm.test('Token saved to collection variable', function() {",
                  "        pm.expect(json.access_token).to.be.a('string');",
                  "        pm.expect(json.token_type).to.eql('bearer');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"client_id\": \"{{client_id}}\",\n    \"client_secret\": \"{{client_secret}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/token",
              "host": ["{{base_url}}"],
              "path": ["token"]
            },
            "description": "Exchange client credentials for a JWT token."
          }
        },
        {
          "name": "Test — No Auth (should 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 without auth', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/articles/stats",
              "host": ["{{base_url}}"],
              "path": ["articles", "stats"]
            },
            "description": "Verify that protected endpoints reject unauthenticated requests."
          }
        },
        {
          "name": "Test — Wrong API Key (should 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Returns 401 with wrong key', function() {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "wrong-key-here"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/stats",
              "host": ["{{base_url}}"],
              "path": ["articles", "stats"]
            },
            "description": "Verify that invalid API keys are rejected."
          }
        }
      ],
      "description": "Authentication flow and negative tests."
    },
    {
      "name": "3. Articles (ETL) — Mini Project 2 Tasks",
      "item": [
        {
          "name": "TASK 1.1 — Article Search (Default Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Pagination structure exists', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('data');",
                  "    pm.expect(jsonData).to.have.property('page', 1);",
                  "    pm.expect(jsonData).to.have.property('per_page', 10);",
                  "    pm.expect(jsonData).to.have.property('total_items');",
                  "    pm.expect(jsonData).to.have.property('total_pages');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/search",
              "host": ["{{base_url}}"],
              "path": ["articles", "search"]
            },
            "description": "Screenshot 1 untuk Laporan: GET /articles/search tanpa filter."
          }
        },
        {
          "name": "TASK 1.2 — Article Search (Filter Source + Date)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/search?source=bbc&date_from=2024-01-01",
              "host": ["{{base_url}}"],
              "path": ["articles", "search"],
              "query": [
                {
                  "key": "source",
                  "value": "bbc"
                },
                {
                  "key": "date_from",
                  "value": "2024-01-01"
                }
              ]
            },
            "description": "Screenshot 2 untuk Laporan: GET /articles/search dengan filter source + date_from."
          }
        },
        {
          "name": "TASK 1.3 — Article Search (Page 2 Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Page is 2', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.page).to.eql(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/search?page=2&per_page=10",
              "host": ["{{base_url}}"],
              "path": ["articles", "search"],
              "query": [
                {
                  "key": "page",
                  "value": "2"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            },
            "description": "Screenshot 3 untuk Laporan: GET /articles/search page 2."
          }
        },
        {
          "name": "TASK 2 — Article Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Has total_articles and by_source', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('total_articles');",
                  "    pm.expect(jsonData).to.have.property('by_source');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/articles/stats",
              "host": ["{{base_url}}"],
              "path": ["articles", "stats"]
            },
            "description": "Screenshot 4 untuk Laporan: GET /articles/stats total & breakdown per source."
          }
        }
      ],
      "description": "Endpoints tugas ETL Mini Project 2."
    },
    {
      "name": "4. Attrition (ELT) — Mini Project 2 Tasks",
      "item": [
        {
          "name": "TASK 3 — Department Detail (Sales)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Department details match schema', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('department');",
                  "    pm.expect(jsonData).to.have.property('total_employees');",
                  "    pm.expect(jsonData).to.have.property('attrition_count');",
                  "    pm.expect(jsonData).to.have.property('attrition_rate');",
                  "    pm.expect(jsonData).to.have.property('avg_income');",
                  "    pm.expect(jsonData).to.have.property('min_income');",
                  "    pm.expect(jsonData).to.have.property('max_income');",
                  "    pm.expect(jsonData).to.have.property('top_earners').that.is.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attrition/department/Sales",
              "host": ["{{base_url}}"],
              "path": ["attrition", "department", "Sales"]
            },
            "description": "Screenshot 5 untuk Laporan: GET /attrition/department/Sales."
          }
        },
        {
          "name": "TASK 4 — Attrition Risk Profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of high risk employees', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attrition/risk-profile?limit=20",
              "host": ["{{base_url}}"],
              "path": ["attrition", "risk-profile"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Screenshot 6 untuk Laporan: GET /attrition/risk-profile."
          }
        },
        {
          "name": "Attrition Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/attrition/summary",
              "host": ["{{base_url}}"],
              "path": ["attrition", "summary"]
            }
          }
        }
      ],
      "description": "Endpoints tugas ELT Mini Project 2."
    }
  ]
}